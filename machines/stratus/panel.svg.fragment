<g id="stratus_panel">
<!-- SDK two-page header: keep this block before machine artwork below y=38. -->
<path d="M0,0 L480,0 L480,38 L0,38 Z" fill="#000000"/>
<path id="stratus_node_0" transform="matrix(1 0 0 1 0 0)" d="M0,0 L60,0 L60,20 L0,20 Z" fill="#000000" stroke="#000000" stroke-width="0.5"/>
